@startuml activity_cycle
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
title Диаграмма деятельности: цикл колонии

start
:Феромон на всех путях = τ₀;
:Муравьи поровну по городам\n(или все в гнезде);
repeat
  repeat
    :Каждый муравей, который ещё не дома,\nвыбирает путь и проходит его;
  repeat while (все вернулись домой?) is (нет) not (да)
  :Маршруты муравьёв и их длины L;
  :Лучший маршрут цикла и за всё время;
  :Нанести феромон:\nτ = τ + ρ · ΣΔτ, Δτ = Q / L\n(+ e · Q / L лучшего, если e > 0);
  :Испарение: τ = τ · (1 − ρ);
  :Статистика: лучший, средний,\nдоля на одном маршруте, дорог в ходу;
  :Муравьи снова дома, посещённых нет;
repeat while (выполнено M циклов?) is (нет) not (да)
:Лучший найденный маршрут;
stop
@enduml
