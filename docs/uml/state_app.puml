@startuml state_app
!pragma layout smetana
skinparam dpi 150
skinparam defaultFontName Arial
skinparam shadowing false
title Диаграмма состояний: колония в окне

[*] --> Готова : запуск (шестиугольник)
state "Нет графа" as Empty : меньше 3 своих городов
state Готова : цикл 0, феромон τ₀
state Идёт : таймер делает перемещения
state Пауза
state Завершена : выполнено M циклов

Готова --> Идёт : Пуск
Идёт --> Пауза : Пауза
Пауза --> Идёт : Пуск
Готова --> Пауза : Шаг / Цикл
Пауза --> Пауза : Шаг / Цикл
Идёт --> Завершена : M-й цикл
Пауза --> Завершена : До конца / M-й цикл
Готова --> Завершена : До конца
Завершена --> Готова : Сначала
Пауза --> Готова : Сначала / параметры / граф
Идёт --> Готова : параметры / граф
Готова --> Empty : «Свои города»
Empty --> Готова : поставлен 3-й город
Готова --> Empty : убран город (осталось 2)
@enduml
